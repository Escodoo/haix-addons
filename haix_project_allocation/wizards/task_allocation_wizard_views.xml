<odoo>
    <record id="project_task_allocation_wizard_view_form" model="ir.ui.view">
        <field name="name">project.task.allocation.wizard.form</field>
        <field name="model">project.task.allocation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field
                            name="task_id"
                            readonly="context.get('default_task_id')"
                        />
                        <label for="date_from" string="Days" />
                        <div class="o_row">
                            <field name="date_from" />
                            <i class="fa fa-long-arrow-right mx-2" title="To" />
                            <field name="date_to" />
                        </div>
                        <label for="shift_ids" />
                        <div class="o_row">
                            <field name="shift_ids" widget="many2many_tags" />
                            <button
                                name="action_full_day"
                                type="object"
                                string="Full Day"
                                class="btn-link"
                            />
                        </div>
                    </group>
                    <group>
                        <field name="team_id" />
                        <field name="team_members_only" invisible="not team_id" />
                        <field name="show_unavailable" />
                        <field name="company_id" invisible="1" />
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list
                        editable="bottom"
                        create="false"
                        delete="false"
                        decoration-success="status == 'available'"
                        decoration-warning="status == 'partial'"
                        decoration-muted="status == 'allocated'"
                        decoration-danger="status == 'absent'"
                    >
                        <field name="sequence" column_invisible="True" />
                        <field
                            name="selected"
                            widget="boolean_toggle"
                            readonly="already_allocated"
                            nolabel="1"
                        />
                        <field name="employee_id" readonly="1" />
                        <field name="is_team_member" readonly="1" optional="hide" />
                        <field name="status" readonly="1" />
                        <field
                            name="free_hours"
                            widget="float_time"
                            readonly="1"
                            optional="show"
                        />
                        <field
                            name="work_hours"
                            widget="float_time"
                            readonly="1"
                            optional="hide"
                        />
                        <field name="detail" readonly="1" />
                        <field name="already_allocated" column_invisible="True" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Allocate"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
