<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form - haix_project_allocation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <group name="departure" position="before">
                <group name="allocation" string="Field Team">
                    <field name="allocation_eligible" />
                    <field
                        name="allocation_team_id"
                        invisible="not allocation_eligible"
                    />
                </group>
            </group>
        </field>
    </record>

    <record id="hr_employee_view_search" model="ir.ui.view">
        <field name="name">hr.employee.search - haix_project_allocation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter" />
        <field name="arch" type="xml">
            <field name="job_id" position="after">
                <field name="allocation_team_id" />
                <filter
                    name="filter_allocation_eligible"
                    string="Field Team"
                    domain="[('allocation_eligible', '=', True)]"
                />
            </field>
        </field>
    </record>

    <record id="hr_employee_view_list_allocation" model="ir.ui.view">
        <field name="name">hr.employee.list.allocation</field>
        <field name="model">hr.employee</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false">
                <field name="name" readonly="1" />
                <field name="department_id" readonly="1" optional="show" />
                <field name="job_id" readonly="1" optional="show" />
                <field name="allocation_eligible" widget="boolean_toggle" />
                <field name="allocation_team_id" />
                <field name="resource_calendar_id" optional="show" />
                <field name="company_id" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="hr_employee_action_allocation" model="ir.actions.act_window">
        <field name="name">Field Team</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[Command.clear(),
                   Command.create({'view_mode': 'list', 'view_id': ref('hr_employee_view_list_allocation')})]"
        />
        <field name="context">{'search_default_filter_allocation_eligible': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Mark the employees that work in the field
            </p>
            <p>
                Only field team employees can be allocated to tasks.
            </p>
        </field>
    </record>
</odoo>
