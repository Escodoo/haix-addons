<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form - haix_account</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="partner_shipping_id" position="after">
                <field name="measurement_partner_id" />
                <field name="billing_partner_id" />
            </field>
        </field>
    </record>

    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="name">sale.order.list quotation - haix_account</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="measurement_partner_id" optional="hide" />
                <field name="billing_partner_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">sale.order.list - haix_account</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="measurement_partner_id" optional="hide" />
                <field name="billing_partner_id" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
