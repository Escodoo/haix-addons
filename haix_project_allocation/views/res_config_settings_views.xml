<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form - haix_project_allocation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <app name="project" position="inside">
                <block title="Team Allocation" name="allocation_setting_container">
                    <setting
                        id="allocation_block_overlap_setting"
                        help="Prevent an employee from having two overlapping allocations. When disabled, overlaps are allowed and flagged."
                    >
                        <field name="allocation_block_overlap" />
                    </setting>
                </block>
            </app>
        </field>
    </record>
</odoo>
