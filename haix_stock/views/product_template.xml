<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.haix.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='general_information']//field[@name='categ_id']"
                position="before"
            >
                <field name="haix_unique_number" />
            </xpath>
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Rental (Haix)" name="haix_rental">
                    <group>
                        <group string="Classification">
                            <field name="haix_asset_type" />
                            <field name="haix_requires_inspection" />
                        </group>
                        <group string="Values">
                            <field name="currency_id" invisible="1" />
                            <field name="haix_indemnity_value" />
                            <field name="haix_used_sale_value" />
                            <field name="haix_supplier_value" />
                        </group>
                        <group string="Unavailable" invisible="type != 'consu'">
                            <field name="haix_qty_inspection" />
                            <field name="haix_qty_maintenance" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.list.haix.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <field name="default_code" position="before">
                <field name="haix_unique_number" optional="show" />
            </field>
            <field name="default_code" position="after">
                <field name="haix_asset_type" optional="show" />
                <field name="haix_requires_inspection" optional="hide" />
                <field name="haix_indemnity_value" optional="hide" />
            </field>
        </field>
    </record>

    <record id="product_template_search_view" model="ir.ui.view">
        <field name="name">product.template.search.haix.stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <field name="categ_id" position="before">
                <field name="haix_unique_number" />
            </field>
            <filter name="categ_id" position="after">
                <filter
                    string="Asset Type"
                    name="haix_asset_type"
                    context="{'group_by': 'haix_asset_type'}"
                />
            </filter>
        </field>
    </record>
</odoo>
