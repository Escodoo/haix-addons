<odoo>
    <record id="project_task_allocation_view_timeline" model="ir.ui.view">
        <field name="name">project.task.allocation.timeline</field>
        <field name="model">project.task.allocation</field>
        <field name="type">timeline</field>
        <field name="arch" type="xml">
            <timeline
                date_start="date_start"
                date_stop="date_end"
                default_group_by="employee_id"
                event_open_popup="true"
                stack="false"
                mode="week"
                colors="#ec7063: has_conflict == true"
            >
                <field name="employee_id" />
                <field name="task_id" />
                <field name="project_id" />
                <field name="shift_id" />
                <field name="team_id" />
                <field name="has_conflict" />
                <templates>
                    <t t-name="timeline-item">
                        <div class="o_allocation_timeline_item">
                            <strong t-esc="record.shift_id[1]" />
                            <span> · </span>
                            <span t-esc="record.task_id[1]" />
                            <span t-if="record.project_id">
                                · <t t-esc="record.project_id[1]" />
                            </span>
                            <small t-if="record.team_id" class="ms-1 text-muted">
                                (<t t-esc="record.team_id[1]" />)
                            </small>
                        </div>
                    </t>
                </templates>
            </timeline>
        </field>
    </record>

    <record id="project_task_allocation_view_list" model="ir.ui.view">
        <field name="name">project.task.allocation.list</field>
        <field name="model">project.task.allocation</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-danger="has_conflict" multi_edit="1">
                <field name="employee_id" />
                <field name="task_id" />
                <field name="project_id" optional="show" />
                <field name="partner_id" optional="hide" />
                <field name="allocation_date" />
                <field name="shift_id" />
                <field name="date_start" optional="hide" />
                <field name="date_end" optional="hide" />
                <field
                    name="duration_hours"
                    widget="float_time"
                    sum="Total"
                    optional="show"
                />
                <field name="team_id" optional="show" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
                <field name="has_conflict" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="project_task_allocation_view_form" model="ir.ui.view">
        <field name="name">project.task.allocation.form</field>
        <field name="model">project.task.allocation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_substitute_wizard"
                        type="object"
                        string="Substitute Employee"
                        groups="haix_project_allocation.group_allocation_manager"
                        invisible="not id or not active"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not warning_message"
                    >
                        <field name="warning_message" />
                    </div>
                    <div
                        class="alert alert-danger"
                        role="alert"
                        invisible="not conflict_allocation_ids"
                    >
                        This allocation overlaps:
                        <field name="conflict_allocation_ids" widget="many2many_tags" />
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" />
                            <field name="task_id" />
                            <field name="project_id" />
                            <field name="partner_id" />
                            <field name="team_id" />
                        </group>
                        <group>
                            <field name="allocation_date" />
                            <field name="shift_id" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="duration_hours" widget="float_time" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="active" invisible="1" />
                            <field name="has_conflict" invisible="1" />
                        </group>
                    </group>
                    <field name="note" placeholder="Notes..." />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="project_task_allocation_view_calendar" model="ir.ui.view">
        <field name="name">project.task.allocation.calendar</field>
        <field name="model">project.task.allocation</field>
        <field name="arch" type="xml">
            <calendar
                date_start="date_start"
                date_stop="date_end"
                color="employee_id"
                mode="week"
                quick_create="0"
                event_open_popup="1"
            >
                <field name="employee_id" filters="1" />
                <field name="task_id" />
                <field name="shift_id" />
                <field name="team_id" />
            </calendar>
        </field>
    </record>

    <record id="project_task_allocation_view_pivot" model="ir.ui.view">
        <field name="name">project.task.allocation.pivot</field>
        <field name="model">project.task.allocation</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="employee_id" type="row" />
                <field name="allocation_date" interval="week" type="col" />
                <field name="duration_hours" type="measure" widget="float_time" />
            </pivot>
        </field>
    </record>

    <record id="project_task_allocation_view_graph" model="ir.ui.view">
        <field name="name">project.task.allocation.graph</field>
        <field name="model">project.task.allocation</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="employee_id" />
                <field name="duration_hours" type="measure" widget="float_time" />
            </graph>
        </field>
    </record>

    <record id="project_task_allocation_view_search" model="ir.ui.view">
        <field name="name">project.task.allocation.search</field>
        <field name="model">project.task.allocation</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id" />
                <field name="task_id" />
                <field name="project_id" />
                <field name="partner_id" />
                <field name="team_id" string="Team" />
                <field
                    name="employee_id"
                    string="Team Member"
                    filter_domain="[('employee_id.allocation_team_id', 'ilike', self)]"
                />
                <field name="shift_id" />
                <separator />
                <filter
                    name="filter_today"
                    string="Today"
                    domain="[('allocation_date', '=', context_today().strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="filter_this_week"
                    string="This Week"
                    domain="[('allocation_date', '&gt;=', (context_today() + relativedelta(weeks=-1, days=1, weekday=0)).strftime('%Y-%m-%d')), ('allocation_date', '&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"
                />
                <filter
                    name="filter_next_week"
                    string="Next Week"
                    domain="[('allocation_date', '&gt;=', (context_today() + relativedelta(days=1, weekday=0)).strftime('%Y-%m-%d')), ('allocation_date', '&lt;=', (context_today() + relativedelta(weeks=1, weekday=6)).strftime('%Y-%m-%d'))]"
                />
                <separator />
                <filter
                    name="filter_conflict"
                    string="With Conflict"
                    domain="[('has_conflict', '=', True)]"
                />
                <filter
                    name="filter_no_team"
                    string="Without Team"
                    domain="[('team_id', '=', False)]"
                />
                <separator />
                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_employee"
                        string="Employee"
                        context="{'group_by': 'employee_id'}"
                    />
                    <filter
                        name="group_team"
                        string="Team"
                        context="{'group_by': 'team_id'}"
                    />
                    <filter
                        name="group_project"
                        string="Project"
                        context="{'group_by': 'project_id'}"
                    />
                    <filter
                        name="group_partner"
                        string="Customer"
                        context="{'group_by': 'partner_id'}"
                    />
                    <filter
                        name="group_day"
                        string="Day"
                        context="{'group_by': 'allocation_date:day'}"
                    />
                    <filter
                        name="group_shift"
                        string="Shift"
                        context="{'group_by': 'shift_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_project_task_allocation" model="ir.actions.act_window">
        <field name="name">Team Planning</field>
        <field name="res_model">project.task.allocation</field>
        <field name="view_mode">timeline,list,calendar,pivot,graph,form</field>
        <field name="context">{'search_default_filter_this_week': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Allocate the field team to tasks
            </p>
            <p>
                Use "Allocate Team" on a task, or create allocations here.
                Each person gets one line in the timeline.
            </p>
        </field>
    </record>
</odoo>
