<odoo>
    <record id="project_allocation_shift_view_list" model="ir.ui.view">
        <field name="name">project.allocation.shift.list</field>
        <field name="model">project.allocation.shift</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="source" />
                <field
                    name="day_period"
                    invisible="source != 'calendar'"
                    required="source == 'calendar'"
                />
                <field
                    name="hour_start"
                    widget="float_time"
                    invisible="source != 'fixed'"
                />
                <field
                    name="hour_end"
                    widget="float_time"
                    invisible="source != 'fixed'"
                />
                <field name="in_full_day" />
                <field name="color" widget="color_picker" optional="hide" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>

    <record id="project_allocation_shift_view_form" model="ir.ui.view">
        <field name="name">project.allocation.shift.form</field>
        <field name="model">project.allocation.shift</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="source" widget="radio" />
                            <field
                                name="day_period"
                                invisible="source != 'calendar'"
                                required="source == 'calendar'"
                            />
                            <field
                                name="hour_start"
                                widget="float_time"
                                invisible="source != 'fixed'"
                            />
                            <field
                                name="hour_end"
                                widget="float_time"
                                invisible="source != 'fixed'"
                            />
                            <field
                                name="crosses_midnight"
                                invisible="source != 'fixed'"
                            />
                        </group>
                        <group>
                            <field name="in_full_day" />
                            <field name="sequence" />
                            <field name="color" widget="color_picker" />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="project_allocation_shift_view_search" model="ir.ui.view">
        <field name="name">project.allocation.shift.search</field>
        <field name="model">project.allocation.shift</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="filter_calendar"
                    string="Working Schedule"
                    domain="[('source', '=', 'calendar')]"
                />
                <filter
                    name="filter_fixed"
                    string="Fixed Hours"
                    domain="[('source', '=', 'fixed')]"
                />
                <separator />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="project_allocation_shift_action" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">project.allocation.shift</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
