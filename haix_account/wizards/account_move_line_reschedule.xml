<odoo>
    <record id="account_move_line_reschedule_form_view" model="ir.ui.view">
        <field name="name">account.move.line.reschedule.form</field>
        <field name="model">account.move.line.reschedule</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="expected_payment_date" />
                    <field name="reason" />
                </group>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="move_id" />
                        <field name="partner_id" />
                        <field name="date_maturity" />
                        <field name="expected_payment_date" />
                        <field name="amount_residual" sum="Total" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_reschedule"
                        type="object"
                        string="Reschedule"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="account_move_line_reschedule_action" model="ir.actions.act_window">
        <field name="name">Reschedule Expected Payment Date</field>
        <field name="res_model">account.move.line.reschedule</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>
