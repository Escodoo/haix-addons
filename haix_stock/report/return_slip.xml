<odoo>
    <record id="action_report_return_slip" model="ir.actions.report">
        <field name="name">Return Slip</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">haix_stock.report_return_slip</field>
        <field name="report_file">haix_stock.report_return_slip</field>
        <field
            name="print_report_name"
        >'Romaneio de devolucao - %s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="stock.model_stock_picking" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_return_slip_document">
        <t t-call="web.external_layout">
            <t
                t-set="o"
                t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"
            />
            <div class="page">
                <h3>Return Slip <span t-field="o.name" /></h3>
                <div class="row mt-3 mb-3">
                    <div class="col-6">
                        <strong>Customer:</strong>
                        <span t-field="o.partner_id.commercial_partner_id" />
                        <br />
                        <strong>Pickup address:</strong>
                        <div
                            t-field="o.partner_id"
                            t-options="{'widget': 'contact', 'fields': ['address'], 'no_marker': True}"
                        />
                    </div>
                    <div class="col-6">
                        <strong>Lease sheet:</strong>
                        <span t-field="o.haix_analytic_account_id" />
                        <br />
                        <strong>Order:</strong>
                        <span t-field="o.origin" />
                        <br />
                        <strong>Scheduled pickup:</strong>
                        <span
                            t-field="o.scheduled_date"
                            t-options="{'widget': 'date'}"
                        />
                    </div>
                </div>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Unique No.</th>
                            <th>Product</th>
                            <th>Serial</th>
                            <th class="text-end">Expected</th>
                            <th class="text-end">Checked</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t
                            t-foreach="o.move_ids.filtered(lambda m: m.state != 'cancel')"
                            t-as="move"
                        >
                            <t
                                t-set="lots"
                                t-value="move.move_line_ids.lot_id or move.move_orig_ids.move_line_ids.lot_id"
                            />
                            <tr>
                                <td>
                                    <span
                                        t-field="move.product_id.haix_unique_number"
                                    />
                                </td>
                                <td>
                                    <span t-field="move.product_id" />
                                </td>
                                <td>
                                    <span t-esc="', '.join(lots.mapped('name'))" />
                                </td>
                                <td class="text-end">
                                    <span t-field="move.product_uom_qty" />
                                    <span t-field="move.product_uom" />
                                </td>
                                <td style="width: 15%;" />
                                <td style="width: 25%;" />
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div class="row mt-5">
                    <div class="col-4 text-center">
                        ______________________________<br />Driver
                    </div>
                    <div class="col-4 text-center">
                        ______________________________<br />Customer
                    </div>
                    <div class="col-4 text-center">
                        ______________________________<br />Receiving check
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_return_slip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="haix_stock.report_return_slip_document" />
            </t>
        </t>
    </template>
</odoo>
