<odoo>
    <record id="module_category_team_allocation" model="ir.module.category">
        <field name="name">Team Allocation</field>
        <field name="parent_id" ref="base.module_category_services" />
        <field name="sequence">50</field>
    </record>

    <record id="group_allocation_user" model="res.groups">
        <field name="name">Allocation: Read</field>
        <field name="category_id" ref="module_category_team_allocation" />
        <field
            name="implied_ids"
            eval="[Command.link(ref('project.group_project_user'))]"
        />
    </record>

    <record id="group_allocation_manager" model="res.groups">
        <field name="name">Allocation: Scheduling</field>
        <field name="category_id" ref="module_category_team_allocation" />
        <field name="implied_ids" eval="[Command.link(ref('group_allocation_user'))]" />
        <field name="users" eval="[Command.link(ref('base.user_admin'))]" />
    </record>
</odoo>
